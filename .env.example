# loom config. Loaded by the VS Code extension from <workspaceRoot>/.env.
# Precedence: VS Code settings > .env > process.env. Lines starting with # are ignored.

# Which provider to use: openai | anthropic
MY_AGENT_PROVIDER=openai

# --- OpenAI (required when MY_AGENT_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Leave OPENAI_BASE_URL empty for api.openai.com. Override for OpenAI-compatible
# endpoints (Ollama: http://localhost:11434/v1, Groq, OpenRouter, LM Studio, etc.)
OPENAI_BASE_URL=
# "" | low | medium | high — only meaningful for reasoning-capable models.
OPENAI_REASONING_EFFORT=

# --- Anthropic (required when MY_AGENT_PROVIDER=anthropic) ---
# Note: the Anthropic provider is currently a stub and will return an error
# until it's implemented. Use openai for now.
ANTHROPIC_API_KEY=
MY_AGENT_MODEL=claude-opus-4-7
