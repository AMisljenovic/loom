node_modules/
dist/
bin/
out/
*.vsix
.DS_Store

# Keep .vscode/ tracked (shared settings) but not user-local stuff
.vscode/*.log

.env

# Loom per-workspace runtime artifacts. Curated content (.loom/commands,
# .loom/skills, .loom/agents) is tracked. With LOOM_STORAGE_DIR set by the
# VS Code host, scratchpad + index live outside the repo entirely; these
# globs keep the legacy fallback path out of git for headless / pre-upgrade
# installs.
.loom/scratchpad/
.loom/index.db
.loom/index.db-shm
.loom/index.db-wal
