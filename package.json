{
  "name": "loom",
  "displayName": "My Agent",
  "description": "AI coding agent with a Go backend",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:loom.open",
    "onCommand:loom.setAnthropicKey",
    "onCommand:loom.setOpenAIKey"
  ],
  "contributes": {
    "commands": [
      {
        "command": "loom.open",
        "title": "My Agent: Open Chat"
      },
      {
        "command": "loom.setAnthropicKey",
        "title": "Loom: Set Anthropic API Key"
      },
      {
        "command": "loom.setOpenAIKey",
        "title": "Loom: Set OpenAI API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loom",
          "title": "My Agent",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "loom": [
        {
          "type": "webview",
          "id": "loom.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "My Agent",
      "properties": {
        "loom.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic",
            "local"
          ],
          "default": "anthropic",
          "order": 10,
          "markdownDescription": "**Loom: Provider**\n\nLLM provider. Can also be set via `MY_AGENT_PROVIDER` in `.env`."
        },
        "loom.anthropicApiKey": {
          "type": "string",
          "default": "",
          "order": 20,
          "markdownDescription": "**Loom: Anthropic**\n\nDeprecated plaintext Anthropic API key fallback.",
          "deprecationMessage": "Use the 'Loom: Set Anthropic API Key' command instead."
        },
        "loom.model": {
          "type": "string",
          "default": "claude-opus-4-7",
          "order": 21,
          "markdownDescription": "**Loom: Anthropic**\n\nAnthropic model id. Can also be set via `MY_AGENT_MODEL` in `.env`."
        },
        "loom.openai.apiKey": {
          "type": "string",
          "default": "",
          "order": 30,
          "markdownDescription": "**Loom: OpenAI**\n\nDeprecated plaintext OpenAI API key fallback.",
          "deprecationMessage": "Use the 'Loom: Set OpenAI API Key' command instead."
        },
        "loom.openai.baseUrl": {
          "type": "string",
          "default": "",
          "order": 31,
          "markdownDescription": "**Loom: OpenAI**\n\nOpenAI base URL. Leave empty for api.openai.com, or point at an OpenAI-compatible endpoint. Also `OPENAI_BASE_URL`."
        },
        "loom.openai.model": {
          "type": "string",
          "default": "gpt-5",
          "order": 32,
          "markdownDescription": "**Loom: OpenAI**\n\nOpenAI model id. Can also be set via `OPENAI_MODEL` in `.env`."
        },
        "loom.openai.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "order": 33,
          "markdownDescription": "**Loom: OpenAI**\n\nReasoning effort for reasoning-capable models. Empty uses provider default. Also `OPENAI_REASONING_EFFORT`."
        },
        "loom.local.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "order": 40,
          "markdownDescription": "**Loom: Local**\n\nOpenAI-compatible local endpoint base URL."
        },
        "loom.local.model": {
          "type": "string",
          "default": "llama3.1",
          "order": 41,
          "markdownDescription": "**Loom: Local**\n\nLocal OpenAI-compatible model id."
        }
      }
    }
  },
  "scripts": {
    "install:all": "npm install && npm --prefix webview-ui install",
    "build:ts": "node esbuild.config.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "build:agent": "node scripts/build-agent.mjs",
    "build:agent:all": "node scripts/build-agent.mjs --all",
    "build": "npm run build:agent && npm run build:webview && npm run build:ts",
    "test:ts": "vitest run",
    "watch": "node esbuild.config.mjs --watch",
    "package": "node scripts/package.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.21.0",
    "husky": "^9.1.6",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "minimatch": "^10.2.5"
  }
}
