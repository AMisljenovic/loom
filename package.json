{
  "name": "loom",
  "displayName": "My Agent",
  "description": "AI coding agent with a Go backend",
  "version": "0.1.0",
  "publisher": "your-publisher-id",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:myAgent.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "myAgent.open",
        "title": "My Agent: Open Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "myAgent",
          "title": "My Agent",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "myAgent": [
        {
          "type": "webview",
          "id": "myAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "My Agent",
      "properties": {
        "myAgent.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ],
          "default": "anthropic",
          "description": "LLM provider. Can also be set via MY_AGENT_PROVIDER in .env."
        },
        "myAgent.anthropicApiKey": {
          "type": "string",
          "default": "",
          "description": "Anthropic API key (or set ANTHROPIC_API_KEY in .env / env)."
        },
        "myAgent.model": {
          "type": "string",
          "default": "claude-opus-4-7",
          "description": "Anthropic model id (or set MY_AGENT_MODEL in .env)."
        },
        "myAgent.openai.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API key (or set OPENAI_API_KEY in .env / env). Required when provider=openai."
        },
        "myAgent.openai.baseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI base URL. Leave empty for api.openai.com, or point at an OpenAI-compatible endpoint (Ollama, Groq, OpenRouter, LM Studio). Also OPENAI_BASE_URL."
        },
        "myAgent.openai.model": {
          "type": "string",
          "default": "gpt-5",
          "description": "OpenAI model id (or set OPENAI_MODEL in .env)."
        },
        "myAgent.openai.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high"
          ],
          "default": "",
          "description": "Reasoning effort for reasoning-capable models. Empty disables. Also OPENAI_REASONING_EFFORT."
        }
      }
    }
  },
  "scripts": {
    "install:all": "npm install && npm --prefix webview-ui install",
    "build:ts": "node esbuild.config.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "build:agent": "node scripts/build-agent.mjs",
    "build:agent:all": "node scripts/build-agent.mjs --all",
    "build": "npm run build:agent && npm run build:webview && npm run build:ts",
    "watch": "node esbuild.config.mjs --watch",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.27.0"
  }
}